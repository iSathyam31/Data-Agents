{
    "table_name": "ITEM",
    "table_description": "Item/product dimension. Contains product attributes including category, brand, class, manufacturer, and pricing for ~500K items.",
    "use_cases": [
        "Product performance analysis",
        "Category/brand sales ranking",
        "Product attribute segmentation",
        "Price point analysis"
    ],
    "data_quality_notes": [
        "I_ITEM_SK is the surrogate key for all fact table joins",
        "I_ITEM_ID is the natural/business key",
        "I_REC_START_DATE / I_REC_END_DATE implement SCD Type 2 — same item can have multiple rows",
        "I_CURRENT_PRICE is the current list price, not what was actually charged",
        "I_CATEGORY and I_CLASS form a product hierarchy: category > class > item"
    ],
    "key_columns": [
        {
            "name": "I_ITEM_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "I_ITEM_ID",
            "type": "VARCHAR",
            "description": "Business key"
        },
        {
            "name": "I_ITEM_DESC",
            "type": "VARCHAR",
            "description": "Product description"
        },
        {
            "name": "I_CURRENT_PRICE",
            "type": "DECIMAL",
            "description": "Current list price"
        },
        {
            "name": "I_WHOLESALE_COST",
            "type": "DECIMAL",
            "description": "Wholesale cost"
        },
        {
            "name": "I_BRAND",
            "type": "VARCHAR",
            "description": "Brand name"
        },
        {
            "name": "I_CLASS",
            "type": "VARCHAR",
            "description": "Product class (sub-category)"
        },
        {
            "name": "I_CATEGORY",
            "type": "VARCHAR",
            "description": "Product category (top level)"
        },
        {
            "name": "I_MANUFACT",
            "type": "VARCHAR",
            "description": "Manufacturer name"
        },
        {
            "name": "I_SIZE",
            "type": "VARCHAR",
            "description": "Product size"
        },
        {
            "name": "I_COLOR",
            "type": "VARCHAR",
            "description": "Product color"
        },
        {
            "name": "I_REC_START_DATE",
            "type": "DATE",
            "description": "SCD2 start date"
        },
        {
            "name": "I_REC_END_DATE",
            "type": "DATE",
            "description": "SCD2 end date — NULL means current"
        }
    ]
}