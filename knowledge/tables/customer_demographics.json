{
    "table_name": "CUSTOMER_DEMOGRAPHICS",
    "table_description": "Customer demographics dimension. Contains education, marital status, income band, purchase estimates, etc.",
    "use_cases": [
        "Customer demographic segmentation",
        "Marketing target analysis",
        "Income-based purchasing patterns"
    ],
    "data_quality_notes": [
        "CD_DEMO_SK is the surrogate key — join from CUSTOMER via C_CURRENT_CDEMO_SK",
        "Small dimension table"
    ],
    "key_columns": [
        {
            "name": "CD_DEMO_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "CD_GENDER",
            "type": "VARCHAR",
            "description": "M/F"
        },
        {
            "name": "CD_MARITAL_STATUS",
            "type": "VARCHAR",
            "description": "S(single)/M(married)/D(divorced)/W(widowed)/U(unknown)"
        },
        {
            "name": "CD_EDUCATION_STATUS",
            "type": "VARCHAR",
            "description": "Education level"
        },
        {
            "name": "CD_PURCHASE_ESTIMATE",
            "type": "INT",
            "description": "Estimated annual purchases"
        },
        {
            "name": "CD_CREDIT_RATING",
            "type": "VARCHAR",
            "description": "Credit rating category"
        },
        {
            "name": "CD_DEP_COUNT",
            "type": "INT",
            "description": "Number of dependents"
        }
    ]
}