{
    "table_name": "ecommerce.reviews",
    "table_description": "Product reviews with 1-5 star ratings and text comments from users.",
    "use_cases": [
        "Product satisfaction analysis",
        "Rating distribution",
        "Review volume trends",
        "Identifying low-rated products"
    ],
    "data_quality_notes": [
        "rating is INTEGER with CHECK constraint: 1 to 5",
        "A user can review multiple products",
        "~100 reviews seeded across products and users",
        "created_at spans the last 6 months",
        "No uniqueness constraint on (product_id, user_id) — a user could review the same product multiple times"
    ],
    "table_columns": [
        {
            "name": "review_id",
            "type": "SERIAL",
            "description": "Primary key"
        },
        {
            "name": "product_id",
            "type": "INTEGER",
            "description": "FK to products(product_id)"
        },
        {
            "name": "user_id",
            "type": "INTEGER",
            "description": "FK to users(user_id)"
        },
        {
            "name": "rating",
            "type": "INTEGER",
            "description": "Star rating 1-5"
        },
        {
            "name": "comment",
            "type": "TEXT",
            "description": "Review text"
        },
        {
            "name": "created_at",
            "type": "TIMESTAMP",
            "description": "When the review was posted"
        }
    ]
}