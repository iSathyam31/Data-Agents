{
    "table_name": "WEB_SITE",
    "schema": "SNOWFLAKE_SAMPLE_DATA.TPCDS_SF100TCL",
    "full_reference": "SNOWFLAKE_SAMPLE_DATA.TPCDS_SF100TCL.WEB_SITE",
    "table_description": "Dimension table for web properties (e-commerce websites). SCD Type 2 — changes in management or classification create new rows. Referenced by WEB_SALES.WS_WEB_SITE_SK. Provides context about which web property generated which online sales.",
    "use_cases": [
        "Web site revenue and order volume comparison",
        "Web site market and division performance",
        "Tax rate analysis for web orders by site",
        "Site manager performance reporting"
    ],
    "data_quality_notes": [
        "SCD Type 2 — WEB_REC_END_DATE IS NULL identifies current active record.",
        "WEB_CLOSE_DATE_SK is NULL for active sites.",
        "WEB_TAX_PERCENTAGE is a decimal (e.g. 0.05 = 5%).",
        "The primary key column is WEB_SITE_SK (no prefix — different convention from other dimensions)."
    ],
    "table_columns": [
