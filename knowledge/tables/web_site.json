{
    "table_name": "WEB_SITE",
    "table_description": "Web site dimension. Attributes of the company's web properties.",
    "use_cases": [
        "Web site performance comparison"
    ],
    "data_quality_notes": [
        "WEB_SITE_SK is the surrogate key",
        "SCD Type 2 — WEB_REC_START_DATE / WEB_REC_END_DATE"
    ],
    "key_columns": [
        {
            "name": "WEB_SITE_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "WEB_SITE_ID",
            "type": "VARCHAR",
            "description": "Business key"
        },
        {
            "name": "WEB_NAME",
            "type": "VARCHAR",
            "description": "Site name"
        },
        {
            "name": "WEB_OPEN_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — launch date"
        },
        {
            "name": "WEB_CLOSE_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — close date (NULL=active)"
        }
    ]
}