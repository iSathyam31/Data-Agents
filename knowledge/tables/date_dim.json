{
    "table_name": "DATE_DIM",
    "table_description": "Date dimension. Contains one row per calendar date with extensive date attributes. CRITICAL join table for all fact tables.",
    "use_cases": [
        "Time-based filtering and aggregation",
        "Year-over-year comparisons",
        "Fiscal period analysis",
        "Holiday/weekend analysis"
    ],
    "data_quality_notes": [
        "D_DATE_SK is the surrogate key — ALL fact tables join here on *_DATE_SK columns",
        "D_DATE is the actual DATE value — use this for date arithmetic",
        "D_YEAR, D_MOY (month of year), D_DOM (day of month) for grouping",
        "D_QOY = quarter of year (1-4)",
        "D_FY_YEAR, D_FY_QUARTER_SEQ for fiscal year analysis",
        "Always use DATE_DIM joins instead of date arithmetic on surrogate keys"
    ],
    "key_columns": [
        {
            "name": "D_DATE_SK",
            "type": "INT",
            "description": "Surrogate PK — join target for all fact tables"
        },
        {
            "name": "D_DATE",
            "type": "DATE",
            "description": "Actual calendar date"
        },
        {
            "name": "D_DATE_ID",
            "type": "VARCHAR",
            "description": "Business key"
        },
        {
            "name": "D_YEAR",
            "type": "INT",
            "description": "Calendar year (e.g. 2001)"
        },
        {
            "name": "D_MOY",
            "type": "INT",
            "description": "Month of year (1-12)"
        },
        {
            "name": "D_DOM",
            "type": "INT",
            "description": "Day of month (1-31)"
        },
        {
            "name": "D_QOY",
            "type": "INT",
            "description": "Quarter of year (1-4)"
        },
        {
            "name": "D_DOW",
            "type": "INT",
            "description": "Day of week"
        },
        {
            "name": "D_MONTH_SEQ",
            "type": "INT",
            "description": "Sequential month number"
        },
        {
            "name": "D_WEEK_SEQ",
            "type": "INT",
            "description": "Sequential week number"
        },
        {
            "name": "D_FY_YEAR",
            "type": "INT",
            "description": "Fiscal year"
        },
        {
            "name": "D_HOLIDAY",
            "type": "VARCHAR",
            "description": "Y/N is holiday"
        }
    ]
}