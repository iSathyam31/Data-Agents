{
    "table_name": "CALL_CENTER",
    "schema": "SNOWFLAKE_SAMPLE_DATA.TPCDS_SF100TCL",
    "full_reference": "SNOWFLAKE_SAMPLE_DATA.TPCDS_SF100TCL.CALL_CENTER",
    "table_description": "Dimension table for call centers that process catalog channel orders. SCD Type 2 — changes in staffing or management create new rows. Contains location, staffing, market info, and tax rate. Referenced by CATALOG_SALES.CS_CALL_CENTER_SK and CATALOG_RETURNS.CR_CALL_CENTER_SK.",
    "use_cases": [
        "Call center revenue and order volume performance",
        "Call center staffing vs sales productivity",
        "Regional call center comparison",
        "Tax rate analysis for catalog orders by call center"
    ],
    "data_quality_notes": [
        "SCD Type 2 — CC_REC_END_DATE IS NULL identifies current active record.",
        "CC_CLOSED_DATE_SK is NULL for active call centers.",
        "CC_TAX_PERCENTAGE is a decimal rate (e.g. 0.05 = 5%).",
        "CC_SQ_FT is floor space in square feet.",
        "CC_HOURS describes operating hours as text."
    ],
    "table_columns": [
