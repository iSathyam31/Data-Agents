{
    "table_name": "TIME_DIM",
    "table_description": "Time-of-day dimension. Contains one row per second of the day (86,400 rows).",
    "use_cases": [
        "Intraday sales patterns",
        "Peak hour analysis"
    ],
    "data_quality_notes": [
        "T_TIME_SK is surrogate key",
        "Only STORE_SALES has a time dimension FK (SS_SOLD_TIME_SK)",
        "Small table"
    ],
    "key_columns": [
        {
            "name": "T_TIME_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "T_TIME",
            "type": "INT",
            "description": "Seconds since midnight"
        },
        {
            "name": "T_HOUR",
            "type": "INT",
            "description": "Hour (0-23)"
        },
        {
            "name": "T_MINUTE",
            "type": "INT",
            "description": "Minute (0-59)"
        },
        {
            "name": "T_MEAL_TIME",
            "type": "VARCHAR",
            "description": "Meal time category"
        }
    ]
}