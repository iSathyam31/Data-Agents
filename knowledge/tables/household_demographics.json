{
    "table_name": "HOUSEHOLD_DEMOGRAPHICS",
    "table_description": "Household demographics dimension. Income band, buy potential, household size, vehicle count.",
    "use_cases": [
        "Household segmentation",
        "Buy potential analysis"
    ],
    "data_quality_notes": [
        "HD_DEMO_SK is the surrogate key",
        "HD_INCOME_BAND_SK joins to INCOME_BAND",
        "Small dimension"
    ],
    "key_columns": [
        {
            "name": "HD_DEMO_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "HD_INCOME_BAND_SK",
            "type": "INT",
            "description": "FK to INCOME_BAND"
        },
        {
            "name": "HD_BUY_POTENTIAL",
            "type": "VARCHAR",
            "description": "Buy potential category"
        },
        {
            "name": "HD_DEP_COUNT",
            "type": "INT",
            "description": "Dependents"
        },
        {
            "name": "HD_VEHICLE_COUNT",
            "type": "INT",
            "description": "Vehicles owned"
        }
    ]
}