{
    "table_name": "PROMOTION",
    "table_description": "Promotion dimension. Details of promotions applied to sales transactions.",
    "use_cases": [
        "Promotion effectiveness",
        "Discount analysis",
        "Channel-specific promo performance"
    ],
    "data_quality_notes": [
        "P_PROMO_SK is the surrogate key",
        "P_CHANNEL_* flags indicate which channels the promo ran on"
    ],
    "key_columns": [
        {
            "name": "P_PROMO_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "P_PROMO_ID",
            "type": "VARCHAR",
            "description": "Business key"
        },
        {
            "name": "P_PROMO_NAME",
            "type": "VARCHAR",
            "description": "Promotion name"
        },
        {
            "name": "P_START_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — promo start"
        },
        {
            "name": "P_END_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — promo end"
        },
        {
            "name": "P_CHANNEL_TV",
            "type": "VARCHAR",
            "description": "Y/N TV channel"
        },
        {
            "name": "P_CHANNEL_EMAIL",
            "type": "VARCHAR",
            "description": "Y/N email channel"
        },
        {
            "name": "P_DISCOUNT_ACTIVE",
            "type": "VARCHAR",
            "description": "Y/N discount active"
        }
    ]
}