{
    "table_name": "CUSTOMER_ADDRESS",
    "table_description": "Address dimension for customers. Linked from CUSTOMER via C_CURRENT_ADDR_SK.",
    "use_cases": [
        "Geographic segmentation",
        "Regional sales analysis",
        "Shipping zone analysis"
    ],
    "data_quality_notes": [
        "CA_ADDRESS_SK is the surrogate key",
        "CA_STATE is 2-letter state code",
        "CA_GMT_OFFSET for timezone analysis"
    ],
    "key_columns": [
        {
            "name": "CA_ADDRESS_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "CA_STREET_NAME",
            "type": "VARCHAR",
            "description": "Street"
        },
        {
            "name": "CA_CITY",
            "type": "VARCHAR",
            "description": "City"
        },
        {
            "name": "CA_STATE",
            "type": "VARCHAR",
            "description": "State code"
        },
        {
            "name": "CA_ZIP",
            "type": "VARCHAR",
            "description": "ZIP"
        },
        {
            "name": "CA_COUNTRY",
            "type": "VARCHAR",
            "description": "Country"
        },
        {
            "name": "CA_GMT_OFFSET",
            "type": "DECIMAL",
            "description": "GMT offset"
        }
    ]
}