{
    "table_name": "CATALOG_RETURNS",
    "table_description": "Fact table for returns from catalog channel orders. Links to CATALOG_SALES via CR_ORDER_NUMBER + CR_ITEM_SK.",
    "use_cases": [
        "Catalog return rate analysis",
        "Cross-channel return comparison",
        "Return reason trending"
    ],
    "data_quality_notes": [
        "Join to CATALOG_SALES on CR_ORDER_NUMBER = CS_ORDER_NUMBER AND CR_ITEM_SK = CS_ITEM_SK",
        "CR_RETURNED_DATE_SK is the return date",
        "CR_REFUNDED_CUSTOMER_SK may differ from CR_RETURNING_CUSTOMER_SK (gift returns)"
    ],
    "key_columns": [
        {
            "name": "CR_RETURNED_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM"
        },
        {
            "name": "CR_ITEM_SK",
            "type": "INT",
            "description": "FK to ITEM"
        },
        {
            "name": "CR_REFUNDED_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — refund recipient"
        },
        {
            "name": "CR_RETURNING_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — who returned"
        },
        {
            "name": "CR_CALL_CENTER_SK",
            "type": "INT",
            "description": "FK to CALL_CENTER"
        },
        {
            "name": "CR_ORDER_NUMBER",
            "type": "INT",
            "description": "Original order number"
        },
        {
            "name": "CR_RETURN_QUANTITY",
            "type": "INT",
            "description": "Units returned"
        },
        {
            "name": "CR_RETURN_AMOUNT",
            "type": "DECIMAL",
            "description": "Refund amount"
        },
        {
            "name": "CR_NET_LOSS",
            "type": "DECIMAL",
            "description": "Net loss"
        }
    ]
}