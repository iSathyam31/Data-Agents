{
    "table_name": "WEB_SALES",
    "table_description": "Fact table for sales through the web/online channel. One row per line item ordered online.",
    "use_cases": [
        "Web channel revenue analysis",
        "E-commerce performance metrics",
        "Web vs catalog vs store comparison",
        "Online promotion effectiveness",
        "Web page attribution"
    ],
    "data_quality_notes": [
        "WS_SOLD_DATE_SK can be NULL",
        "WS_BILL_CUSTOMER_SK and WS_SHIP_CUSTOMER_SK can differ (gift orders)",
        "WS_WEB_PAGE_SK links to the web page where the purchase happened",
        "WS_WEB_SITE_SK identifies which website",
        "Large table — always filter by date range"
    ],
    "key_columns": [
        {
            "name": "WS_SOLD_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM"
        },
        {
            "name": "WS_SHIP_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM"
        },
        {
            "name": "WS_BILL_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — billed to"
        },
        {
            "name": "WS_SHIP_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — shipped to"
        },
        {
            "name": "WS_ITEM_SK",
            "type": "INT",
            "description": "FK to ITEM"
        },
        {
            "name": "WS_WEB_PAGE_SK",
            "type": "INT",
            "description": "FK to WEB_PAGE"
        },
        {
            "name": "WS_WEB_SITE_SK",
            "type": "INT",
            "description": "FK to WEB_SITE"
        },
        {
            "name": "WS_WAREHOUSE_SK",
            "type": "INT",
            "description": "FK to WAREHOUSE"
        },
        {
            "name": "WS_ORDER_NUMBER",
            "type": "INT",
            "description": "Groups line items"
        },
        {
            "name": "WS_QUANTITY",
            "type": "INT",
            "description": "Units ordered"
        },
        {
            "name": "WS_SALES_PRICE",
            "type": "DECIMAL",
            "description": "Actual price"
        },
        {
            "name": "WS_EXT_SALES_PRICE",
            "type": "DECIMAL",
            "description": "Extended sales"
        },
        {
            "name": "WS_NET_PROFIT",
            "type": "DECIMAL",
            "description": "Net profit"
        }
    ]
}