            "description": "Foreign key to departments"
        },
        {
            "name": "Ward_Name",
            "type": "VARCHAR(50)",
            "description": "Name of the ward"
        },
        {
            "name": "Ward_Type",
            "type": "VARCHAR(50)",
            "description": "ICU, General, Maternity, etc."
        }
    ]
}