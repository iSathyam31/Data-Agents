{
    "table_name": "ecommerce.order_items",
    "table_description": "Line items within orders. Links orders to products with quantity and price at time of purchase.",
    "use_cases": [
        "Product-level revenue",
        "Items per order analysis",
        "Product popularity",
        "Basket analysis"
    ],
    "data_quality_notes": [
        "unit_price is the price at time of purchase (may differ from current product price)",
        "quantity ranges from 1 to 3",
        "Line total = quantity * unit_price",
        "ON DELETE CASCADE from orders — if an order is deleted, its items are too",
        "Each order has 1-5 items"
    ],
    "table_columns": [
        {
            "name": "order_item_id",
            "type": "SERIAL",
            "description": "Primary key"
        },
        {
            "name": "order_id",
            "type": "INTEGER",
            "description": "FK to orders(order_id), CASCADE delete"
        },
        {
            "name": "product_id",
            "type": "INTEGER",
            "description": "FK to products(product_id)"
        },
        {
            "name": "quantity",
            "type": "INTEGER",
            "description": "Number of units ordered"
        },
        {
            "name": "unit_price",
            "type": "DECIMAL(10,2)",
            "description": "Price per unit at time of purchase"
        }
    ]
}