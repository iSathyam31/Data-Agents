{
    "table_name": "STORE_RETURNS",
    "table_description": "Fact table for returns at physical stores. Links back to STORE_SALES via SR_TICKET_NUMBER + SR_ITEM_SK.",
    "use_cases": [
        "Return rate analysis",
        "Return reason analysis",
        "Net revenue after returns",
        "Customer return behavior patterns"
    ],
    "data_quality_notes": [
        "Join to STORE_SALES on SR_TICKET_NUMBER = SS_TICKET_NUMBER AND SR_ITEM_SK = SS_ITEM_SK",
        "SR_RETURNED_DATE_SK is when the return happened, not when the sale happened",
        "SR_RETURN_AMT is the refund amount",
        "SR_REASON_SK links to REASON dimension for return reason"
    ],
    "key_columns": [
        {
            "name": "SR_RETURNED_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — return date"
        },
        {
            "name": "SR_ITEM_SK",
            "type": "INT",
            "description": "FK to ITEM — returned product"
        },
        {
            "name": "SR_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — who returned"
        },
        {
            "name": "SR_STORE_SK",
            "type": "INT",
            "description": "FK to STORE — where returned"
        },
        {
            "name": "SR_REASON_SK",
            "type": "INT",
            "description": "FK to REASON — why returned"
        },
        {
            "name": "SR_TICKET_NUMBER",
            "type": "INT",
            "description": "Original sale ticket number"
        },
        {
            "name": "SR_RETURN_QUANTITY",
            "type": "INT",
            "description": "Units returned"
        },
        {
            "name": "SR_RETURN_AMT",
            "type": "DECIMAL",
            "description": "Refund amount"
        },
        {
            "name": "SR_NET_LOSS",
            "type": "DECIMAL",
            "description": "Net loss from this return"
        }
    ]
}