{
    "table_name": "ecommerce.shipping_details",
    "table_description": "Shipping and delivery tracking for shipped/delivered orders. Only orders with status 'Shipped' or 'Delivered' have shipping records.",
    "use_cases": [
        "Delivery performance",
        "Carrier comparison",
        "Shipping status distribution",
        "Delivery time analysis"
    ],
    "data_quality_notes": [
        "NOT all orders have shipping records — only 'Shipped' and 'Delivered' orders",
        "shipping_status values: 'In Transit', 'Out for Delivery', 'Delivered', 'Pending'",
        "carrier values: 'FedEx', 'UPS', 'DHL', 'USPS'",
        "tracking_number is UNIQUE",
        "estimated_delivery is DATE (not TIMESTAMP)",
        "estimated_delivery = order_date + 3-7 days",
        "Pending, Processing, and Cancelled orders will NOT appear in this table"
    ],
    "table_columns": [
        {
            "name": "shipping_id",
            "type": "SERIAL",
            "description": "Primary key"
        },
        {
            "name": "order_id",
            "type": "INTEGER",
            "description": "FK to orders(order_id)"
        },
        {
            "name": "tracking_number",
            "type": "VARCHAR(100)",
            "description": "Unique tracking number"
        },
        {
            "name": "carrier",
            "type": "VARCHAR(50)",
            "description": "Shipping carrier: FedEx, UPS, DHL, USPS"
        },
        {
            "name": "shipping_status",
            "type": "VARCHAR(50)",
            "description": "Shipping status"
        },
        {
            "name": "estimated_delivery",
            "type": "DATE",
            "description": "Expected delivery date"
        }
    ]
}