{
    "table_name": "WEB_RETURNS",
    "table_description": "Fact table for returns from web/online orders. Links to WEB_SALES via WR_ORDER_NUMBER + WR_ITEM_SK.",
    "use_cases": [
        "Web return rate analysis",
        "E-commerce return reason analysis",
        "Cross-channel return comparison"
    ],
    "data_quality_notes": [
        "Join to WEB_SALES on WR_ORDER_NUMBER = WS_ORDER_NUMBER AND WR_ITEM_SK = WS_ITEM_SK",
        "WR_RETURNED_DATE_SK is when the return happened",
        "WR_REFUNDED_CUSTOMER_SK may differ from WR_RETURNING_CUSTOMER_SK"
    ],
    "key_columns": [
        {
            "name": "WR_RETURNED_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM"
        },
        {
            "name": "WR_ITEM_SK",
            "type": "INT",
            "description": "FK to ITEM"
        },
        {
            "name": "WR_REFUNDED_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER"
        },
        {
            "name": "WR_RETURNING_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER"
        },
        {
            "name": "WR_WEB_PAGE_SK",
            "type": "INT",
            "description": "FK to WEB_PAGE"
        },
        {
            "name": "WR_ORDER_NUMBER",
            "type": "INT",
            "description": "Original order number"
        },
        {
            "name": "WR_RETURN_QUANTITY",
            "type": "INT",
            "description": "Units returned"
        },
        {
            "name": "WR_RETURN_AMT",
            "type": "DECIMAL",
            "description": "Refund amount"
        },
        {
            "name": "WR_NET_LOSS",
            "type": "DECIMAL",
            "description": "Net loss"
        }
    ]
}