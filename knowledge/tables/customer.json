{
    "table_name": "CUSTOMER",
    "table_description": "Customer dimension. Contains demographic and geographic information for ~100M customers in SF100TCL.",
    "use_cases": [
        "Customer segmentation",
        "Demographic analysis",
        "Geographic sales distribution",
        "Customer lifetime value"
    ],
    "data_quality_notes": [
        "C_CUSTOMER_SK is the surrogate key — use this for joins to fact tables",
        "C_CUSTOMER_ID is the natural/business key",
        "C_CURRENT_ADDR_SK links to current address in CUSTOMER_ADDRESS",
        "C_FIRST_SALES_DATE_SK and C_FIRST_SHIPTO_DATE_SK track acquisition dates"
    ],
    "key_columns": [
        {
            "name": "C_CUSTOMER_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "C_CUSTOMER_ID",
            "type": "VARCHAR",
            "description": "Business key"
        },
        {
            "name": "C_CURRENT_ADDR_SK",
            "type": "INT",
            "description": "FK to CUSTOMER_ADDRESS"
        },
        {
            "name": "C_FIRST_NAME",
            "type": "VARCHAR",
            "description": "First name"
        },
        {
            "name": "C_LAST_NAME",
            "type": "VARCHAR",
            "description": "Last name"
        },
        {
            "name": "C_BIRTH_YEAR",
            "type": "INT",
            "description": "Birth year"
        },
        {
            "name": "C_BIRTH_COUNTRY",
            "type": "VARCHAR",
            "description": "Country of birth"
        },
        {
            "name": "C_EMAIL_ADDRESS",
            "type": "VARCHAR",
            "description": "Email"
        },
        {
            "name": "C_PREFERRED_CUST_FLAG",
            "type": "VARCHAR",
            "description": "Y/N preferred customer"
        }
    ]
}