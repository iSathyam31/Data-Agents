{
    "table_name": "ecommerce.users",
    "table_description": "Customer accounts with personal info and signup dates. Each user can place multiple orders and write reviews.",
    "use_cases": [
        "Customer analysis",
        "Cohort analysis by signup date",
        "Geographic segmentation",
        "User growth trends"
    ],
    "data_quality_notes": [
        "email is UNIQUE and NOT NULL — safe to use as a natural key",
        "created_at is TIMESTAMP — use DATE_TRUNC for grouping",
        "address is a single TEXT field (street + suite combined), not normalized",
        "phone format varies (not standardized)",
        "~50 users seeded"
    ],
    "table_columns": [
        {
            "name": "user_id",
            "type": "SERIAL",
            "description": "Primary key"
        },
        {
            "name": "first_name",
            "type": "VARCHAR(50)",
            "description": "User's first name"
        },
        {
            "name": "last_name",
            "type": "VARCHAR(50)",
            "description": "User's last name"
        },
        {
            "name": "email",
            "type": "VARCHAR(100)",
            "description": "Unique email address"
        },
        {
            "name": "phone",
            "type": "VARCHAR(50)",
            "description": "Phone number (format varies)"
        },
        {
            "name": "address",
            "type": "TEXT",
            "description": "Street address"
        },
        {
            "name": "city",
            "type": "VARCHAR(50)",
            "description": "City name"
        },
        {
            "name": "zip_code",
            "type": "VARCHAR(50)",
            "description": "Postal/ZIP code"
        },
        {
            "name": "created_at",
            "type": "TIMESTAMP",
            "description": "Account creation timestamp"
        }
    ]
}