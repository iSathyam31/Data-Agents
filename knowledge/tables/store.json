{
    "table_name": "STORE",
    "table_description": "Store dimension. Physical retail store attributes including geography, size, and management.",
    "use_cases": [
        "Store performance comparison",
        "Geographic sales analysis",
        "Store size/type segmentation"
    ],
    "data_quality_notes": [
        "S_STORE_SK is the surrogate key",
        "S_REC_START_DATE / S_REC_END_DATE implement SCD Type 2",
        "S_CLOSED_DATE_SK — if NOT NULL, store is closed"
    ],
    "key_columns": [
        {
            "name": "S_STORE_SK",
            "type": "INT",
            "description": "Surrogate PK"
        },
        {
            "name": "S_STORE_ID",
            "type": "VARCHAR",
            "description": "Business key"
        },
        {
            "name": "S_STORE_NAME",
            "type": "VARCHAR",
            "description": "Store name"
        },
        {
            "name": "S_NUMBER_EMPLOYEES",
            "type": "INT",
            "description": "Employee count"
        },
        {
            "name": "S_FLOOR_SPACE",
            "type": "INT",
            "description": "Floor space sq ft"
        },
        {
            "name": "S_CITY",
            "type": "VARCHAR",
            "description": "City"
        },
        {
            "name": "S_STATE",
            "type": "VARCHAR",
            "description": "State"
        },
        {
            "name": "S_ZIP",
            "type": "VARCHAR",
            "description": "ZIP code"
        },
        {
            "name": "S_COUNTRY",
            "type": "VARCHAR",
            "description": "Country"
        },
        {
            "name": "S_CLOSED_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — NULL means open"
        }
    ]
}