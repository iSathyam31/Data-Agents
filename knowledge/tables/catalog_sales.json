{
    "table_name": "CATALOG_SALES",
    "table_description": "Fact table for sales through the catalog channel (mail-order). One row per line item ordered from a catalog.",
    "use_cases": [
        "Catalog channel revenue analysis",
        "Catalog vs store vs web channel comparison",
        "Shipping cost analysis",
        "Call center performance (via CS_CALL_CENTER_SK)",
        "Catalog promotion ROI"
    ],
    "data_quality_notes": [
        "CS_SOLD_DATE_SK can be NULL — date unknown",
        "CS_SHIP_DATE_SK - CS_SOLD_DATE_SK = shipping delay in days",
        "CS_BILL_CUSTOMER_SK and CS_SHIP_CUSTOMER_SK can differ (gift orders)",
        "CS_WAREHOUSE_SK indicates fulfillment warehouse",
        "Large table — always filter by date range"
    ],
    "key_columns": [
        {
            "name": "CS_SOLD_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — when ordered"
        },
        {
            "name": "CS_SHIP_DATE_SK",
            "type": "INT",
            "description": "FK to DATE_DIM — when shipped"
        },
        {
            "name": "CS_BILL_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — billed to"
        },
        {
            "name": "CS_SHIP_CUSTOMER_SK",
            "type": "INT",
            "description": "FK to CUSTOMER — shipped to"
        },
        {
            "name": "CS_ITEM_SK",
            "type": "INT",
            "description": "FK to ITEM — product"
        },
        {
            "name": "CS_CALL_CENTER_SK",
            "type": "INT",
            "description": "FK to CALL_CENTER"
        },
        {
            "name": "CS_CATALOG_PAGE_SK",
            "type": "INT",
            "description": "FK to CATALOG_PAGE"
        },
        {
            "name": "CS_WAREHOUSE_SK",
            "type": "INT",
            "description": "FK to WAREHOUSE"
        },
        {
            "name": "CS_ORDER_NUMBER",
            "type": "INT",
            "description": "Groups line items into an order"
        },
        {
            "name": "CS_QUANTITY",
            "type": "INT",
            "description": "Units ordered"
        },
        {
            "name": "CS_SALES_PRICE",
            "type": "DECIMAL",
            "description": "Actual price charged"
        },
        {
            "name": "CS_EXT_SALES_PRICE",
            "type": "DECIMAL",
            "description": "Extended sales amount"
        },
        {
            "name": "CS_NET_PROFIT",
            "type": "DECIMAL",
            "description": "Net profit — can be negative"
        }
    ]
}