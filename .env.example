# Azure OpenAI (Chat)
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI (Embeddings)
EMBEDDING_API_KEY=your_key_here
EMBEDDING_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_VERSION=2024-02-01

# Snowflake
SF_ACCOUNT=your_account_identifier
SF_USER=dash_user
SF_PASSWORD=your_password_here
SF_DATABASE=HOSPITAL_DB
SF_SCHEMA=healthcare
SF_WAREHOUSE=COMPUTE_WH
SF_ROLE_ANALYST=dash_analyst_role
SF_ROLE_ENGINEER=dash_engineer_role
# ChromaDB persistence path (optional, defaults to ./chroma_data)
CHROMA_PATH=./chroma_data
